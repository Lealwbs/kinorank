# Configuracao local do KinoRank
# Copie este arquivo para .env e preencha as chaves opcionais abaixo.
# O sistema possui fallback local deterministico caso as chaves fiquem vazias.

# 1. Base de dados
# Opcoes: "ml-latest-small" (100k avaliacoes) ou "ml-25m" (25M avaliacoes)
MOVIELENS_VARIANT=ml-latest-small
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# 2. TMDB API (Posteres, sinopses, diretores e duracao)
# Chave v3 ou Read Access Token v4: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_MAX_ENRICH_ITEMS=500

# 3. Provedor de LLM (Extracao de filtros e explicacao das recomendacoes)
# Opcoes: "gemini" | "openai" | "groq" | "deterministic"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_TIMEOUT_SECONDS=8.0

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# 4. Feature Store
# Usa memoria/DuckDB automaticamente quando o Redis nao esta ativo
REDIS_URL=redis://localhost:6379/0

# 5. Publicacao (Hugging Face e Kaggle)
HF_TOKEN=
HF_USERNAME=Lealwbs
HF_MODEL_REPO=Lealwbs/kinorank-hybrid-recsys
HF_SPACE_REPO=Lealwbs/kinorank

KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=
